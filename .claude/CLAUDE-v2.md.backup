## Sanity Studio Patterns

### Schema Definition
```typescript
// ✅ Use defineType and defineField
import { defineType, defineField } from 'sanity';

export const eventType = defineType({
  name: 'event',
  title: 'Event',
  type: 'document',
  fields: [
    defineField({
      name: 'title',
      type: 'string',
      validation: (rule) => rule.required()
    })
  ]
});
```

### Multi-Site Architecture
**Key Concept**: All document schemas automatically get a `sites` field injected via `apps/studio/schemaTypes/index.ts:10-42`.

```typescript
// ✅ Enable multi-site content
export const sharedContentType = defineType({
  name: 'sharedContent',
  type: 'document',
  options: {
    crossSite: true  // Allows assignment to multiple sites
  },
  fields: [...]
});

// ✅ Single-site content (default)
export const siteSpecificType = defineType({
  name: 'siteSpecific',
  type: 'document',
  // No crossSite option = must belong to exactly one site
  fields: [...]
});
```

### Custom Input Components
```typescript
// ✅ Use Sanity's set/unset for input changes
import { set, unset, type ArrayOfPrimitivesInputProps } from 'sanity';
import { useCallback } from 'react';

export const CustomInput = (props: ArrayOfPrimitivesInputProps) => {
  const { value, onChange } = props;

  const handleChange = useCallback((newValue: string) => {
    if (newValue) {
      onChange(set(newValue));
    } else {
      onChange(unset());
    }
  }, [onChange]);

  return <input value={value || ''} onChange={(e) => handleChange(e.target.value)} />;
};
```

### Structure Tool Customization
```typescript
// ✅ Use StructureResolver type
import type { StructureResolver } from 'sanity/structure';

export const structureSite1: StructureResolver = (S, context) => {
  return S.list()
    .id('root')
    .title('Site 1')
    .items([
      S.documentTypeListItem('page').title('Pages'),
      S.divider(),
      S.listItem()
        .title('Upcoming Events')
        .child(
          S.documentList()
            .title('Upcoming')
            .filter('_type == "event" && date >= now()')
            .defaultOrdering([{ field: 'date', direction: 'asc' }])
        )
    ]);
};
```

