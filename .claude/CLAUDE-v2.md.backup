## Multi-Workspace Configuration

### Workspace Setup
**File**: `apps/studio/sanity.config.ts:16-73`

```typescript
// ✅ Shared config pattern
const sharedConfig: SingleWorkspace = {
  projectId,
  dataset,
  schema,
};

const sharedPlugins: PluginOptions[] = [
  visionTool(),
];

// ✅ Workspace-specific config
const site1Config: WorkspaceOptions = {
  ...sharedConfig,
  name: 'site-1',
  title: 'Site 1',
  basePath: '/site-1',
  plugins: [
    structureTool({ structure: structureSite1 }),
    presentationTool({ resolve, previewUrl: {...} }),
    ...sharedPlugins
  ]
};
```

### Site Configuration
**File**: `apps/studio/lib/SITES.ts`

```typescript
// ✅ Single source of truth for site metadata
interface Site {
  name: SiteName;
  title: string;
  url: string;
}

export const SITES: Site[] = [
  { name: 'site-1', title: 'Site 1', url: 'http://localhost:3334' },
  { name: 'site-2', title: 'Site 2', url: 'http://localhost:3335' }
];
```

