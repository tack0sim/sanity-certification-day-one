## Page Builder System

### Block Schema Definition
```typescript
// ✅ Define block as object type
import { defineType, defineField } from 'sanity';

export const heroBlock = defineType({
  name: 'hero',
  title: 'Hero Section',
  type: 'object',  // Blocks are objects, not documents
  fields: [
    defineField({
      name: 'title',
      type: 'string',
      validation: (rule) => rule.required()
    }),
    defineField({
      name: 'image',
      type: 'image',
      options: { hotspot: true }
    })
  ]
});
```

### Block Rendering
```typescript
// ✅ Type-safe block mapper
import type { PAGE_QUERY_SITE_1Result } from '@/sanity/types';

interface PageBuilderProps {
  content: PAGE_QUERY_SITE_1Result;
}

export function PageBuilder({ content }: PageBuilderProps) {
  return (
    <>
      {content?.pageBuilder?.map((block) => {
        switch (block._type) {
          case 'hero':
            return <Hero key={block._key} {...block} />;
          case 'gallery':
            return <Gallery key={block._key} {...block} />;
          default:
            return <div key={block._key}>Unknown block: {block._type}</div>;
        }
      })}
    </>
  );
}
```

