## Code Quality Standards

### Variable Naming
```typescript
// ✅ Use auxiliary verbs for booleans
const isLoading = true;
const hasError = false;
const canEdit = user.role === 'admin';

// ✅ Descriptive function names
const fetchUpcomingEvents = async () => { ... };
const validateSiteSelection = (sites: string[]) => { ... };
```

### Error Handling
```typescript
// ✅ Early returns with guard clauses
function processDocument(doc: DocumentDefinition) {
  if (!doc) {
    throw new Error('Document is required');
  }

  if (!doc.fields || doc.fields.length === 0) {
    console.warn(`Document ${doc.name} has no fields`);
    return null;
  }

  // Main logic here
  return processFields(doc.fields);
}

// ✅ Use custom error types
class SchemaValidationError extends Error {
  constructor(
    message: string,
    public schemaName: string,
    public fieldName?: string
  ) {
    super(message);
    this.name = 'SchemaValidationError';
  }
}
```

### Function Structure
```typescript
// ✅ Use function keyword for pure functions
function calculateDoorTime(eventDate: string, hoursEarly: number): string {
  const date = new Date(eventDate);
  date.setHours(date.getHours() - hoursEarly);
  return date.toISOString();
}

// ✅ Use arrow functions for callbacks
const handleSiteChange = useCallback((siteName: SiteName) => {
  // callback logic
}, [dependencies]);
```

